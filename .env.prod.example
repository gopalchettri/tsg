# Production environment template. Copy to .env.prod and fill in REAL values.
# In OpenShift/K8s these become a Secret + ConfigMap — do NOT commit real secrets.

# --- Database: your real TSG (external) ---
TSG_DB_DSN=mssql+pyodbc://USER:PASSWORD@DBHOST:1433/TSG?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# --- Redis (broker + cache + SSE). Use rediss:// + a password in production. ---
TSG_REDIS_URL=rediss://:PASSWORD@REDISHOST:6379/0

# --- Authentication: REAL JWT (dev bypass is OFF by default; never enable in prod) ---
# AUTH_DEV_MODE stays unset/false.
TSG_JWT_ISSUER=https://sso.yourcompany.com/realms/platform
TSG_JWT_AUDIENCE=tsg
TSG_JWT_JWKS_URL=https://sso.yourcompany.com/realms/platform/protocol/openid-connect/certs
# The token claim that lists the group.id values a caller may access. Change if your SSO uses another name.
TSG_JWT_ENTITIES_CLAIM=entities

# --- Inference model (Azure OpenAI). Put the key in a Secret, not here. ---
LLM_PROVIDER=azure_openai
AZURE_OPENAI_API_KEY=__from_secret__
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Embeddings + reranker (DEFAULT: local in-process, no network) ---
# The default image already includes local models; compose mounts the host dirs (below) to these
# CONTAINER paths, which the app reads via EMBEDDING_MODEL / RERANKER_MODEL:
EMBEDDING_PROVIDER=local
RERANKER_PROVIDER=local
EMBEDDING_MODEL=/models/e5
RERANKER_MODEL=/models/reranker
TSG_EMBEDDING_DIMENSIONS=1024
# Host paths to the model folders on THIS machine (compose bind-mounts these):
EMBEDDING_MODEL_HOST=C:/Users/User/Documents/ResearchWorld/NETRA/DESC_RAG_BOT/models/multilingual-e5-large
RERANKER_MODEL_HOST=C:/Users/User/Documents/GC_Research/Threat_Sceario_Generator/cii-threat-scenario-generator/models/bge-reranker-v2-m3
# Alternative (multi-node / GPU): serve on TEI/vLLM behind a litellm proxy (NOT in compose.prod.yml):
#   EMBEDDING_PROVIDER=litellm_proxy ; RERANKER_PROVIDER=litellm_proxy
#   TSG_LITELLM_BASE_URL=http://YOUR-LITELLM-HOST:4000 ; TSG_LITELLM_API_KEY=__from_secret__

# --- MongoDB (optional — the current slice caches embeddings in-process; Mongo persistence is later) ---
TSG_MONGO_URL=mongodb://MONGOHOST:27017

# --- Deployment env (FAIL-CLOSED in staging/prod) ---
# APP_ENV=prod refuses to boot if auth is bypassed (AUTH_DEV_MODE).
APP_ENV=prod

# --- Pool sizing: keep (api replicas + workers) × (pool_size + overflow) under the MSSQL cap ---
TSG_DB_POOL_SIZE=5
TSG_DB_MAX_OVERFLOW=5
TSG_MAX_ACTIVE_SESSIONS=100

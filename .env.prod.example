# Production/UAT environment template. Copy to .env.uat and fill in REAL values.
# In OpenShift/K8s these become a Secret + ConfigMap — do NOT commit real secrets.
#
# HOW THIS FILE ACTUALLY GETS LOADED (it does not happen by magic — a file named .env.uat is
# NOT read automatically; config.py's default is ".env"):
#   docker compose -> docker/compose.prod.yml already points `env_file:` at ../.env.uat
#   OpenShift/K8s  -> every key below must land in the ConfigMap/Secret as a real env var
#                     (real env vars always win over any file)
#   direct run     -> export TSG_ENV_FILE=.env.uat   (a missing path fails loudly rather than
#                     silently falling back to .env, which would start you on DEV config)

# --- Database: your real TSG (external) ---
TSG_DB_DSN=mssql+pyodbc://USER:PASSWORD@DBHOST:1433/TSG?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# --- Redis (broker + cache + live updates). Use rediss:// + a password in production. ---
TSG_REDIS_URL=rediss://:PASSWORD@REDISHOST:6379/0

# --- Login system (SSO). The dev login bypass is OFF by default — never enable it in production. ---
# AUTH_DEV_MODE stays unset/false.
# [retired: header auth] TSG_JWT_ISSUER=https://sso.yourcompany.com/realms/platform
# [retired: header auth] TSG_JWT_AUDIENCE=tsg
# [retired: header auth] TSG_JWT_JWKS_URL=https://sso.yourcompany.com/realms/platform/protocol/openid-connect/certs
# Change this only if your SSO uses a different field name for the list of allowed organizations.
# [retired: header auth] TSG_JWT_ENTITIES_CLAIM=entities

# --- Chat model (Azure OpenAI, DEFAULT). Put the key in a Secret, not here. ---
LLM_PROVIDER=azure_openai
AZURE_OPENAI_API_KEY=__from_secret__
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Alternative — route chat through litellm instead of Azure directly (also the config to use for
# UAT / the jump server; copy this file to .env.uat, fill in real DB/JWT values, keep these as-is):
#   LLM_PROVIDER=litellm_proxy
#   TSG_LITELLM_BASE_URL=https://llmapi.govai.ae
#   TSG_LITELLM_API_KEY=__from_secret__
#   TSG_INFERENCE_MODEL=glm-5   # or kimi-k2.5 — just swap this one value, no code change

# --- Embeddings + reranker (DEFAULT: run locally, no network needed) ---
# The default image does not include the model files — they must exist on the HOST machine at
# EMBEDDING_MODEL_HOST / RERANKER_MODEL_HOST below. If they're missing, download them first
# (e.g. `huggingface-cli download intfloat/multilingual-e5-large`) — otherwise the app refuses
# to start and clearly says which path is missing.
EMBEDDING_PROVIDER=local
RERANKER_PROVIDER=local
EMBEDDING_MODEL=/models/e5
RERANKER_MODEL=/models/reranker
# Must match whichever embedding model is actually configured (local or litellm_proxy below), or
# the app refuses to start rather than silently producing wrong results.
TSG_EMBEDDING_DIMENSIONS=1024
# Model folders on this machine (mounted into the container):
EMBEDDING_MODEL_HOST=C:/Users/User/Documents/ResearchWorld/NETRA/DESC_RAG_BOT/models/multilingual-e5-large
RERANKER_MODEL_HOST=C:/Users/User/Documents/GC_Research/Threat_Sceario_Generator/cii-threat-scenario-generator/models/bge-reranker-v2-m3
# Alternative (multi-node/GPU, or UAT/jump server): use litellm instead of local models. Leave
# EMBEDDING_PROVIDER/RERANKER_PROVIDER unset when LLM_PROVIDER=litellm_proxy above — they follow
# it automatically. Only set them explicitly for a hybrid setup:
#   EMBEDDING_PROVIDER=litellm_proxy ; RERANKER_PROVIDER=litellm_proxy
#   TSG_LITELLM_BASE_URL=https://llmapi.govai.ae ; TSG_LITELLM_API_KEY=__from_secret__
#   TSG_EMBEDDING_MODEL=qwen3-embedding-8b-mig
#   TSG_EMBEDDING_DIMENSIONS=4096
#   TSG_RERANKER_MODEL=qwen3-reranker-8b-mig

# --- Step-4 control mapping ---
# TSG_CONTROL_MAP_MIN_SCORE: LEAVE UNSET normally — the cutoff auto-follows this
# environment's (embedding, reranker) model pair via grounding.resolve_thresholds, so the
# remote models above get their own derived cutoff instead of dev's number. Pin a value
# only after a deliberate manual calibration (controls_mapped audit rows carry the applied
# cutoff + per-control scores — that is the calibration data).
# TSG_RERANK_CONCURRENCY caps concurrent remote rerank HTTP calls (local politeness cap;
# the Redis LLM-slot semaphore remains the global limit). Ignored by a local reranker.
# TSG_CONTROL_MAP_MIN_SCORE=60
# TSG_CONTROL_MAP_TOP_K=5
# TSG_RERANK_CONCURRENCY=8

# --- Optional safety features (litellm_proxy only, both off by default) ---
# LLM_MODERATION_ENABLED=true                 # flags generated scenario text; a soft flag, never a hard block
# LLM_MODERATION_MODEL=<proxy's moderation model name>   # optional — omit to use the proxy's default
# LLM_GUARDRAILS=["pii-detector"]              # optional proxy-side safety filter name(s)

# --- MongoDB ---
TSG_MONGO_URL=mongodb://MONGOHOST:27017

# --- Which environment this is (blocks the dev login bypass from ever running here) ---
APP_ENV=prod

# --- Pool sizing: keep (api replicas + workers) × (pool_size + overflow) under the database's connection cap ---
TSG_DB_POOL_SIZE=5
TSG_DB_MAX_OVERFLOW=5
TSG_MAX_ACTIVE_SESSIONS=100

# --- Admin gate (REQUIRED — empty means EVERY admin route 401s) ---
# Unlocks the threat-library embeddings + import routes, including the vector-cache rebuild you
# need after changing the embedding model. Generate one per environment:
#   python -c "import secrets; print(secrets.token_hex(32))"
TSG_ADMIN_API_KEY=__from_secret__
TSG_FLOWER_BASIC_AUTH=__from_secret__   # "user:password"; the flower service refuses to start while empty

# --- litellm auth header (only when the proxy is behind a gateway) ---
# litellm authenticates with `Authorization: Bearer <key>`. If a gateway in front of it consumes
# or rewrites that header, every call 401s while the SAME key works in a custom header. Set this
# to that header name and the key is sent in both — safe either side of a gateway.
# LITELLM_API_KEY_HEADER=x-litellm-api-key

# --- Scale limits ---
# 0 (default) = unlimited concurrent AI calls across all workers; a coordinated scale-out then
# stampedes the model cluster. Size it to what your serving deployment sustains.
TSG_MAX_CONCURRENT_LLM_CALLS=32
# 0 (default) = a single tenant can consume every MAX_ACTIVE_SESSIONS slot.
TSG_MAX_ACTIVE_SESSIONS_PER_ENTITY=20
# API-enforced JSON replies — fewer parse failures. Supported by glm-5 / kimi-k2.5 / gpt-5-mini.
TSG_LLM_JSON_MODE=true
# "Generate next set" accumulation: TSG_NEXT_SET_SIZE = scenarios per click (default 5).
# SPEND NOTE — read before sizing this environment. How many scenarios a threat earns is no
# longer a constant: it is one per supporting system that could credibly carry that threat to the
# asset. Per-session generation therefore scales with the ASSET's architecture (threats × its own
# plausible entry points), not with a number you can cap here — an asset with many supporting
# systems legitimately costs several times one with few. TSG_NEXT_SET_SIZE still bounds the work
# per click, and TSG_COVERAGE_ATTEMPT_SLACK (default 2) bounds retries when the model keeps
# re-using one entry point; neither shortens the analysis itself.
# TSG_NEXT_SET_SIZE=5
# TSG_COVERAGE_ATTEMPT_SLACK=2
# REMOVED: TSG_MAX_SCENARIOS_PER_THREAT — setting it is now a startup error, not a silent no-op
# (app/core/config.py::_RETIRED_SETTINGS).
# Separate database per environment so vectors + calibrated thresholds never mix.
TSG_MONGO_DB=tsg_embeddings_uat


# ============================================================================
# Settings documented for parity across every environment (tests/test_reason_contract.py).
# Values here are the code defaults, left COMMENTED — uncomment only what this
# environment actually overrides. The KEY SET must match across .env, .env.example,
# .env.uat and .env.prod.example; the VALUES are expected to differ.
# Source of truth for meaning and bounds: app/core/config.py.
# ============================================================================
# TSG_ACTIVE_SESSIONS_WARN_RATIO=0.9
# This deployment's module identity (default 'tsg'); an API_Client key is valid only for its Module.
# TSG_API_MODULE=tsg
# true = also verify (user, entity) against user_scope_assignment (see app/api/deps.get_principal)
# TSG_VERIFY_MEMBERSHIP=false
# AUTH_DEV_MODE=false
# TSG_CAPACITY_RETRY_AFTER_SECONDS=10
# CELERY_BROKER_URL=<set-me>
# CELERY_RESULT_BACKEND=
# Empty (default) = no cross-origin browser access. JSON list, e.g. ["https://app.example.com"].
# TSG_CORS_ALLOWED_ORIGINS=[]
# TSG_DB_CONNECT_TIMEOUT_SECONDS=5
# TSG_DB_POOL_TIMEOUT=30
# TSG_DB_STATEMENT_TIMEOUT_SECONDS=30
# EMBEDDING_PREFIX_STYLE=auto
# EMBEDDING_STORE=mongo
# Grounding thresholds — MUST be measured and pinned for whatever embedding/reranker pair this
# environment runs; do NOT rely on the defaults or on auto-calibration. Calibration cannot succeed
# against a catalogue containing reciprocal near-synonyms (max(negatives) exceeds min(positives)),
# and dev measured the worst genuinely-wrong match at 76.95 — under the default 75 cutoff that is
# banded `verified` and its master ids trusted. Dev pins 90 for multilingual-e5-large +
# bge-reranker-v2-m3; that value is NOT transferable to a different model pair. Run
# scripts/calibrate_grounding.py, hand-classify the negatives, then set the value below.
# The TSG_ prefix is REQUIRED.
# TSG_GROUNDING_MATCH_THRESHOLD=<measure-me>
# TSG_GROUNDING_SHORTLIST_K=10
# TSG_INTEL_ENABLED=true
# TSG_INTEL_ICS_ADVISORIES_ENABLED=true
# TSG_INTEL_ICS_ADVISORIES_URL=<set-me>
# TSG_INTEL_KEV_ENABLED=true
# TSG_INTEL_KEV_URL=<set-me>
# OTX_API_KEY=<set-me>
# TSG_INTEL_OTX_FRESH_PAGES=2
# TSG_INTEL_OTX_MAX_PAGES=200
# TSG_INTEL_OTX_PAGE_SIZE=50
# TSG_INTEL_OTX_SYNC_SECONDS=400
# TSG_INTEL_OTX_URL=<set-me>
# TSG_INTEL_REFRESH_INTERVAL_SECONDS=86400
# TSG_INTEL_TAXII_SERVERS=
# TSG_INTEL_TTL_DAYS=30
# TSG_INTEL_URLHAUS_ENABLED=false
# TSG_INTEL_URLHAUS_URL=<set-me>
# TSG_JWT_ALGORITHMS=RS256
# TSG_JWT_SECRET=<set-me>
# Curation cutoff, INDEPENDENT of TSG_GROUNDING_MATCH_THRESHOLD. A threat scoring below this is
# promoted into the library on accept. Must never exceed the match threshold — config.py fails
# closed at boot, so if you pin the match threshold BELOW 75 you must lower this too.
# TSG_LIBRARY_PROMOTION_THRESHOLD=75.0
# TSG_LLM_MAX_RETRIES=3
# LLM_REASONING_EFFORT=
# TSG_LLM_SLOT_HEARTBEAT_SECONDS=10.0
# TSG_LLM_SLOT_REDIS_TIMEOUT_SECONDS=3.0
# TSG_LLM_SLOT_STALE_AFTER_SECONDS=30.0
# TSG_LLM_SLOT_WAIT_TIMEOUT_SECONDS=30.0
# TSG_LLM_SLOTS_WARN_RATIO=0.8
# LLM_TEMPERATURE=
# TSG_LLM_TIMEOUT_SECONDS=90.0
# TSG_LOCAL_MODEL_CACHE_SIZE=4
# TSG_LOCAL_MODEL_THREADPOOL_SIZE=10
# LOG_LEVEL=INFO
# TSG_MAX_THREATS_PER_ASSET=10
# TSG_MONGO_CONNECT_TIMEOUT_MS=3000
# OPENAI_API_KEY=<set-me>
# TSG_OPENAI_BASE_URL=<set-me>
# TSG_POOL_UTILIZATION_WARN_RATIO=0.9

# --- Library-promotion retry (accept.py's isolated Phase 2 / reaper.py's periodic sweep) ---
# What: after a session's threats are accepted, Phase 2 dedupes/mints/embeds them into the
# shared threat library in a separate step that can fail on its own (LLM hiccup, embedder
# timeout) without undoing the accept. These settings control how those failures are tracked
# and retried. Admin API: GET/POST/DELETE /v1/tsg/sessions/promotions/*.

# How often the background sweep checks for failed promotions to retry.
# TSG_PROMOTION_RETRY_INTERVAL_SECONDS=60.0

# A failed promotion stops being auto-retried by the sweep after this many attempts
# ("exhausted"). An admin can still force one via POST .../retry regardless of this cap.
# TSG_PROMOTION_MAX_ATTEMPTS=5

# True (default): the periodic sweep retries failed promotions automatically. False: failures
# just sit and wait — only an admin calling POST .../retry clears them. Turn off if every
# promotion failure should be a human decision rather than an automatic retry.
# TSG_PROMOTION_AUTO_RETRY_ENABLED=true

# Max sessions retried in one sweep pass, so a single tick can't run unboundedly long — any
# remainder is picked up on the next tick. Raise only if the sweep interval is too short to
# drain a real backlog.
# TSG_PROMOTION_SWEEP_BATCH_LIMIT=200

# Page-size cap for GET /v1/tsg/sessions/promotions (the admin list of pending/failed promotions).
# TSG_PROMOTION_LIST_MAX_LIMIT=500

# False (default): a threat triaged as "genuinely novel" (below TSG_TRIAGE_AUTO_APPROVE_COSINE
# vs everything in the catalogue) queues into the curator review queue instead of minting
# immediately. True skips that human review step and mints it straight into Threat_Catalogue
# (Source='ai_auto_promoted'). Only turn this on once the triage cosine bands above are
# calibrated for your embedding model — a wrong threshold here pollutes the shared library
# with unreviewed entries.
# TSG_PROMOTION_AUTO_APPROVE_ENABLED=false

# TSG_REAPER_INTERVAL_SECONDS=60.0
# TSG_REAPER_STALE_GRACE_SECONDS=300.0

# --- Promoted from hardcoded module constants (2026-08 config audit) — every value below is
# commented at its former hardcoded default; uncomment only to override for this environment.
# TSG_CALIBRATION_SAMPLE_SIZE=100
# TSG_CALIBRATION_PARAPHRASES_PER_NAME=2
# TSG_EMBEDDING_GROUP_LOCK_TTL_SECONDS=30
# TSG_MONGO_BREAKER_COOLDOWN_SECONDS=30.0
# TSG_EMBEDDING_BATCH_SIZE=100
# TSG_LLM_SLOT_POLL_SECONDS=0.25
# TSG_LLM_SLOT_POLL_JITTER_SECONDS=0.1
# TSG_MAX_EMBED_CHARS=4000
# TSG_MAX_CHAT_CHARS=60000
# TSG_TREATMENT_FREE_TEXT_CAP=2000
# TSG_REAPER_SQL_IN_CHUNK_SIZE=1000
# TSG_LLM_VERIFY_MAX_ATTEMPTS=3
# TSG_LLM_VERIFY_RETRY_BACKOFF_SECONDS=5.0
# Embedding-admin job retry cap on LLM slot shortage (0 = fail on first shortage). Bounded on
# purpose — pipeline tasks stay unbounded, their AttemptCount poison cap is the real ceiling.
# TSG_ADMIN_EMBEDDING_MAX_RETRIES=10
# TSG_ACCEPT_NAMED_IN_MESSAGE=3
# TSG_LIBRARY_IMPORT_STALE_AFTER_SECONDS=3600
# TSG_LIBRARY_IMPORT_SKIPPED_CAP=50
# TSG_MAX_PROPOSAL_CHARS=3500

# TSG_RESULT_EXPIRES_SECONDS=3600
# SCENARIO_GENERATION_TEMPERATURE=
# TSG_SCOPING_SCORE_THRESHOLD=55.0
# TSG_SCOPING_TOP_N=5
# TSG_SELF_CHECK_INTERVAL_SECONDS=300.0
# SEMANTIC_MATCH_THRESHOLD=0.6
# TSG_SSE_BREAKER_COOLDOWN_SECONDS=30.0
# Sizes BOTH the shared Redis subscriber pool and the semaphore gating session_events().
# TSG_SSE_MAX_CONCURRENT_STREAMS=180
# TSG_SSE_PING_SECONDS=15
# TSG_SSE_PUBLISH_TIMEOUT_SECONDS=1.0
# TSG_SSE_SEND_TIMEOUT_SECONDS=30.0
# TSG_SSE_SHUTDOWN_GRACE_SECONDS=25.0
# TSG_SSE_SUBSCRIBE_CONNECT_TIMEOUT_SECONDS=2.0
# TSG_SSE_SUBSCRIBER_HEALTH_CHECK_INTERVAL_SECONDS=30.0
# TSG_SSE_SUBSCRIBER_SOCKET_TIMEOUT_SECONDS=10.0
# TSG_STAGE_LEASE_SECONDS=300
# TSG_STAGE_MAX_ATTEMPTS=5
# TSG_TEMPDB_LONG_TXN_WARN_SECONDS=300
# TSG_TEMPDB_VERSION_STORE_WARN_MB=1024
# TSG_TENANT_ID=DESC
# THREAT_IDENTIFICATION_TEMPERATURE=0.0
# TSG_THREAT_LIBRARY_IMPORT_MAX_UPLOAD_MB=128

# --- Scoring & calibration (2026-08) — every entry COMMENTED: the code default applies
# --- until you uncomment. Session-tunable values can also be overridden per-session via
# --- the Config_Tuning table (no restart; next session picks it up).

# Risk-treatment-plan module toggle.
# TSG_RISK_MODULE_ENABLED=false
# Sampling temperature for treatment-plan generation.
# TSG_TREATMENT_TEMPERATURE=0.0
# LEAVE UNSET to derive from llm_timeout_seconds x retries — pinning stops tracking real LLM timing.
# TSG_TREATMENT_STALE_SECONDS=
# Most-recent sibling scenarios quoted in a variant prompt (prompt width, not detector width).
# TSG_VARIANT_SIBLING_PROMPT_K=3
# Cosine that logs two threat labels as near-duplicates. EMBEDDING-MODEL-SPECIFIC — re-derive after a model change.
# TSG_SEMANTIC_NEAR_DUPLICATE_THRESHOLD=0.92
# Stricter ceiling for DIFFERENT-category pairs (relabelled verbatim repeats); must stay above
# both 0.92 and the measured 0.969 cross-class trap. See app/core/config.py.
# TSG_SEMANTIC_CROSS_CATEGORY_THRESHOLD=0.98
# Every threat's score starts here. Coupled: base_score + default_rule_weight must stay ABOVE
# scoping_score_threshold or startup fails (config._validate_scoring_floor_invariant).
# TSG_BASE_SCORE=50.0
# relevance_* scoping-rule delta when the rule's Metadata carries no explicit weight. See invariant above.
# TSG_DEFAULT_RULE_WEIGHT=10.0
# difflib ratio at/above which a scenario is flagged as a near-duplicate (reviewer warning, not rejection).
# TSG_SIBLING_SIMILARITY_RATIO=0.85
# Advisories injected per scenario prompt. SPEND: raising this raises tokens on every scenario LLM call.
# TSG_PROMPT_INTEL_LIMIT=5
# Shortest word (chars) that participates in intel keyword search; shorter terms only add noise.
# TSG_INTEL_MIN_TERM_LENGTH=4
# Weight of the auto-written OT scoping rules (boost-only by design — never a gate).
# TSG_AUTO_OT_RELEVANCE_WEIGHT=10.0
# Rerank score at/above which threshold auto-calibration treats two CATALOGUE entries as duplicates and gives up.
# TSG_NEAR_DUPLICATE_SCORE=99.0
# Library-promotion triage bands (cosine of candidate generic name to nearest active catalogue entry).
# EMBEDDING-MODEL-SPECIFIC estimates; approve must stay BELOW reject — the gap IS the human-review band.
# Recalibrate from the promotion_triage audit rows after any embedding model change.
# TSG_TRIAGE_AUTO_REJECT_COSINE=0.95
# TSG_TRIAGE_AUTO_APPROVE_COSINE=0.80

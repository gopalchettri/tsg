# =============================================================================
# TSG production/UAT template — copy to .env.uat and fill in REAL values.
# In OpenShift/K8s these become a Secret + ConfigMap — do NOT commit real secrets.
# HOW THIS FILE GETS LOADED (a file named .env.uat is NOT read automatically):
#   docker compose -> docker/compose.prod.yml points `env_file:` at ../.env.uat
#   OpenShift/K8s  -> every key must land in the ConfigMap/Secret as a real env var
#   direct run     -> export TSG_ENV_FILE=.env.uat (a missing path fails loudly)
# Settings are prefixed TSG_ unless noted; app/core/config.py is the source of
# truth. Convention: ACTIVE lines override the code default; COMMENTED lines show
# the default — uncomment only to override. The key set is kept in sync across
# .env / .env.example / .env.uat / .env.prod.example; only the VALUES differ.
# Names not defined in config.py are silently ignored (extra='ignore') — keep
# this file in sync: python -m app.core.env_selfcheck
# =============================================================================


# --- 1. Core app -------------------------------------------------------------
# App identity shown in OpenAPI docs (/docs title, version, description).
# TSG_APPLICATION_NAME=Threat Scenario Generator
# TSG_APPLICATION_VERSION=1.0
# TSG_APPLICATION_DESCRIPTION=AI-assisted STRIDE threat identification and scenario generation for OT/IT assets
# prod blocks every dev-only bypass from running here.
APP_ENV=prod
# This deployment's module identity; an API_Client key is valid ONLY for its Module.
# TSG_API_MODULE=tsg
# TSG_TENANT_ID=DESC
# LOG_LEVEL=INFO
# --- Step tracing (app.core.tracing) -----------------------------------------
# Where the per-step trace goes. Comma list of:
#   console  human-readable blocks on stdout (the worker window)
#   log      through structlog, so steps join the normal JSON log stream -> Loki
#   file     trace-<pid>.jsonl (summarised, Loki-safe) + trace-<pid>.txt (full dump)
# Empty = tracing off entirely. RESTART-ONLY: settings are cached at startup, so
# changing this while the app runs does nothing until you restart it.
# TRACE_SINKS=
# Where the file sinks write. Relative paths resolve against the PROJECT ROOT, not the
# working directory (start.ps1 opens three windows from different places).
# TRACE_DIR=logs/trace
# Rotation, applied PER PROCESS — each writer gets its own file, because the API workers,
# the Celery worker and beat all log at once and a shared file rotates wrongly on Linux and
# not at all on Windows. Disk budget = processes x TRACE_MAX_BYTES x TRACE_BACKUPS.
# TRACE_MAX_BYTES=52428800
# TRACE_BACKUPS=5
# Tee EVERY app log line (not just traces) into app-<pid>.jsonl for Promtail -> Loki.
# Leave OFF inside Docker/Kubernetes: files die with the container and the platform already
# rotates stdout for you.
# LOG_FILE=false


# --- 2. Database (SQL Server) ------------------------------------------------
# Main application DB (your real TSG instance).
TSG_DB_DSN=mssql+pyodbc://USER:PASSWORD@DBHOST:1433/TSG?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# Pool sizing: keep (api replicas + workers) x (pool_size + overflow) under the
# database's connection cap.
TSG_DB_POOL_SIZE=5
TSG_DB_MAX_OVERFLOW=5
# TSG_DB_POOL_TIMEOUT=30
# TSG_DB_CONNECT_TIMEOUT_SECONDS=5
# TSG_DB_STATEMENT_TIMEOUT_SECONDS=30


# --- 3. Redis & Celery -------------------------------------------------------
# Use rediss:// + a password in production.
TSG_REDIS_URL=rediss://:PASSWORD@REDISHOST:6379/0
# Celery queue/result URLs (fall back to TSG_REDIS_URL when unset).
# CELERY_BROKER_URL=<set-me>
# CELERY_RESULT_BACKEND=
# TSG_RESULT_EXPIRES_SECONDS=3600


# --- 4. MongoDB (embedding cache) --------------------------------------------
TSG_MONGO_URL=mongodb://MONGOHOST:27017
# Separate database per environment so vectors + calibrated thresholds never mix.
TSG_MONGO_DB=tsg_embeddings_uat
# TSG_MONGO_CONNECT_TIMEOUT_MS=3000
# TSG_MONGO_BREAKER_COOLDOWN_SECONDS=30.0
# EMBEDDING_STORE=mongo


# --- 5. Auth & security ------------------------------------------------------
# Admin gate (REQUIRED — empty means EVERY admin route 401s). Generate one per
# environment: python -c "import secrets; print(secrets.token_hex(32))"
TSG_ADMIN_API_KEY=__from_secret__
# "user:password"; the flower service refuses to start while empty. INFRA-ONLY:
# read directly by docker/compose.prod.yml and start.ps1, not by app config.
TSG_FLOWER_BASIC_AUTH=__from_secret__
# true = also verify (user, entity) against user_scope_assignment on every request.
# TSG_VERIFY_MEMBERSHIP=false
# APP_ENV=local/dev refuses to boot against a non-loopback database or Redis, because that
# combination silently disables four production guards (raw exception text to clients, the
# /dev/sse-test page, the active-API_Client boot check, and the membership warning). Set this
# true to state deliberately that you are developing against shared infrastructure.
# TSG_ALLOW_REMOTE_IN_DEV=false
# NOTE: TSG_JWT_*/AUTH_DEV_MODE no longer exist — if set they are silently
# ignored; header auth (X-API-Key) is the only auth model.


# --- 6. LLM — chat provider --------------------------------------------------
# Which AI service handles chat. Azure OpenAI is the default; the litellm recipe
# below is the UAT/jump-server configuration.
LLM_PROVIDER=azure_openai
# Put the key in a Secret, not here.
AZURE_OPENAI_API_KEY=__from_secret__
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# UAT/jump-server recipe — route chat through litellm instead of Azure:
#   LLM_PROVIDER=litellm_proxy
#   TSG_LITELLM_BASE_URL=https://llmapi.govai.ae
#   TSG_LITELLM_API_KEY=__from_secret__
#   TSG_INFERENCE_MODEL=glm-5   # or kimi-k2.5 — swap this one value, no code change
# TSG_INFERENCE_FALLBACK_MODEL — app-side fallback: retry a retryably-failed chat call ONCE on
# this second model (litellm_proxy/openai paths; azure ignores it). Empty/unset = off.
#   TSG_INFERENCE_FALLBACK_MODEL=kimi-k2.5

#   TSG_LITELLM_BYPASS_PROXY=false  # only if the network REQUIRES HTTP_PROXY routing
# litellm auth header (default: empty). Recipe for a proxy behind a gateway that
# consumes the Authorization header (the key is then sent in BOTH headers):
#   LITELLM_API_KEY_HEADER=x-litellm-api-key
# API-enforced JSON replies — fewer parse failures (glm-5 / kimi-k2.5 / gpt-5-mini).
TSG_LLM_JSON_MODE=true
# Strict Structured Outputs for calls that declare a reply schema (the treatment plan), under
# JSON mode. auto = only where litellm vouches for the model (Azure gpt-5-mini yes; proxy aliases
# such as glm-5 / kimi-k2.5 no — their native APIs document only json_object, so they keep
# today's request). on = always (first confirm the proxy's /model/info reports
# supports_response_schema=true for BOTH models). off = never.
# TSG_LLM_STRUCTURED_OUTPUT=auto
# TSG_LLM_TIMEOUT_SECONDS=90.0
# TSG_LLM_MAX_RETRIES=3
# Cap on completion tokens per call (256-32768); empty = provider default.
# On a REASONING model (gpt-5 family, glm-5 / kimi with thinking on) the cap INCLUDES the hidden
# thinking tokens: 4096 can be spent entirely on thinking and come back as an EMPTY reply
# (finish_reason=length -> plan ERROR generation_failed "ran out of output budget"). A treatment
# plan is ~2k visible tokens: use >= 16384 for those models, or pin LLM_REASONING_EFFORT=low.
# TSG_LLM_MAX_OUTPUT_TOKENS=4096
# LLM_TEMPERATURE=
# LLM_REASONING_EFFORT=
# Optional proxy-side safety (litellm_proxy only; defaults: off/empty). Recipe:
#   LLM_MODERATION_ENABLED=true
#   LLM_MODERATION_MODEL=<proxy's moderation model name>
#   LLM_GUARDRAILS=["pii-detector"]
# OpenAI-direct fallbacks.
# OPENAI_API_KEY=<set-me>
# TSG_OPENAI_BASE_URL=<set-me>
# Per-stage sampling temperatures.
# THREAT_IDENTIFICATION_TEMPERATURE=0.0
# SCENARIO_GENERATION_TEMPERATURE=
# Cap on simultaneous AI calls across ALL workers (0 = unlimited — a coordinated
# scale-out then stampedes the model cluster; size to what serving sustains).
TSG_MAX_CONCURRENT_LLM_CALLS=32
# TSG_LLM_SLOT_WAIT_TIMEOUT_SECONDS=30.0
# TSG_LLM_SLOT_HEARTBEAT_SECONDS=10.0
# TSG_LLM_SLOT_STALE_AFTER_SECONDS=30.0
# TSG_LLM_SLOT_REDIS_TIMEOUT_SECONDS=3.0
# TSG_LLM_SLOT_POLL_SECONDS=0.25
# TSG_LLM_SLOT_POLL_JITTER_SECONDS=0.1
# TSG_LLM_SLOTS_WARN_RATIO=0.8
# Retries for the LLM output-verification pass.
# TSG_LLM_VERIFY_MAX_ATTEMPTS=3
# TSG_LLM_VERIFY_RETRY_BACKOFF_SECONDS=5.0


# --- 7. Embeddings & reranker (DEFAULT: litellm proxy, same as UAT) ----------
# These were `local` while this file was written against a single-box deployment. Production
# runs the embedding and reranker APIs, and the difference is not cosmetic: LiteLLMClient.
# rerank_many sends ONE request per query remotely (concurrency-bound, rerank_concurrency=8),
# but flattens EVERY (query, document) pair into one CPU batch locally. Control mapping now
# shortlists 60 candidates per scenario instead of 10 — payload-shaped on the proxy, but
# genuinely ~6x CPU on the local path. Shipping prod as `local` would put that cost in the one
# place it must not land. Keep these matching .env.uat.
EMBEDDING_PROVIDER=litellm_proxy
RERANKER_PROVIDER=litellm_proxy
TSG_LITELLM_BASE_URL=https://llmapi.govai.ae
TSG_LITELLM_API_KEY=__from_secret__
TSG_EMBEDDING_MODEL=qwen3-embedding-8b-mig
TSG_RERANKER_MODEL=qwen3-reranker-8b-mig
# Vector size — MUST match whichever embedding model is actually configured.
# _verify_embedding_dimensions probes the provider at boot and refuses to start on a mismatch.
TSG_EMBEDDING_DIMENSIONS=4096
# TSG_LITELLM_BYPASS_PROXY=false  # only if the network REQUIRES HTTP_PROXY routing
#
# Local alternative (single box, no network). The image does not include the model files —
# they must exist on the HOST at the *_HOST paths, and missing paths fail boot with a clear
# message. Read the rerank-cost note above before choosing this:
#   EMBEDDING_PROVIDER=local ; RERANKER_PROVIDER=local
#   EMBEDDING_MODEL=/models/e5 ; RERANKER_MODEL=/models/reranker
#   TSG_EMBEDDING_DIMENSIONS=1024
#   EMBEDDING_MODEL_HOST=/path/to/multilingual-e5-large
#   RERANKER_MODEL_HOST=/path/to/bge-reranker-v2-m3
# EMBEDDING_PREFIX_STYLE=auto
# TSG_EMBEDDING_BATCH_SIZE=32   # provider per-request cap; 32 for qwen3-embedding-8b-mig
# TSG_EMBEDDING_CONCURRENCY — how many embedding batches are in flight at once.
# 1 (default) sends them one at a time, exactly as before. Higher overlaps the network
# waits: modelled at 300ms/request, 4 -> 3.4x and 8 -> 5.6x on a full recreate. Each
# concurrent call still takes its own LLM slot, so MAX_CONCURRENT_LLM_CALLS stays the
# authority. Raise it 1 -> 4 -> 8 while watching the worker log for 429s: a 429 retries the
# WHOLE job, so too much concurrency is slower than none. Gains nothing if the provider
# serialises requests internally — measure before trusting the numbers above.
# TSG_EMBEDDING_CONCURRENCY=1
# TSG_MAX_EMBED_CHARS=4000
# TSG_MAX_CHAT_CHARS=60000
# TSG_LOCAL_MODEL_CACHE_SIZE=4
# TSG_LOCAL_MODEL_THREADPOOL_SIZE=10
# Concurrent REMOTE rerank HTTP calls (a local reranker batches and ignores this).
# TSG_RERANK_CONCURRENCY=8


# --- 8. Matching & grounding -------------------------------------------------
# Runs during threat identification, right after the AI proposes each threat.
# Question it answers: "is this already in our threat library, or new?"
# Flow: STEP A shortlist similar entries -> STEP B keep the top K
# -> STEP C precise score decides trust.

# STEP A — shortlist. The proposed threat and every library entry are compared
# as vectors (similarity 0-1); entries below this are ignored, the rest become
# candidates. Example — AI proposes "Firmware tampering of meters":
#   library "Firmware tampering"    0.86 -> candidate
#   library "Phishing of operators" 0.31 -> ignored
# If NOTHING clears the floor, the top K still go to step C anyway (fail-open),
# so a weak-but-best match is judged rather than silently dropped.
# SEMANTIC_MATCH_THRESHOLD=0.6
# STEP B — cap. Only the K most similar candidates from step A go on to the
# precise (slower) scorer in step C.
# TSG_GROUNDING_SHORTLIST_K=10
# STEP C — trust decision. The reranker model scores each remaining candidate
# 0-100; the BEST score decides what happens to the proposed threat:
#   >= threshold -> "verified": it ADOPTS the library entry's official name
#                   and ids (dedup, reports, and prompts use the library row).
#   <  threshold -> "unverified": kept as possibly NEW — it still gets
#                   scenarios, and on accept feeds the admin queue (group 11).
# MUST be measured and pinned for THIS environment's model pair (run
# scripts/calibrate_grounding.py; dev's 90 is not transferable). TSG_ prefix
# REQUIRED (a bare GROUNDING_MATCH_THRESHOLD is silently ignored).
# TSG_GROUNDING_MATCH_THRESHOLD=<measure-me>
# The two below are used ONLY by the calibration script that tries to compute
# the step-C threshold from the library itself (scripts/calibrate_grounding.py).
# Stop calibrating when two LIBRARY entries score >= this against each other —
# the library holds near-twins, so no reliable threshold can be computed.
# TSG_NEAR_DUPLICATE_SCORE=99.0
# How many library names it samples / paraphrases it generates per name.
# TSG_CALIBRATION_SAMPLE_SIZE=100
# TSG_CALIBRATION_PARAPHRASES_PER_NAME=2
# How long a `running` calibration row is believed before it reads as abandoned (a killed
# worker would otherwise leave it `running` forever and block every future sweep). Default 3600.
# TSG_CALIBRATION_STALE_AFTER_SECONDS=3600


# --- 9. Scoring & scoping ----------------------------------------------------
# Every identified threat gets a score; only high scorers get scenarios.

# Starting score for every threat. Example: start 50, one matching rule adds
# +10 -> 60, which passes the 55 cutoff. (50 + 10 must stay above the cutoff
# or the app refuses to start.)
# TSG_BASE_SCORE=50.0
# Points a scoping rule adds when it defines no weight of its own.
# Minimum score a threat needs to survive. Example: 60 passes, 52 is dropped.
# TSG_SCOPING_SCORE_THRESHOLD=55.0
# Unset (the default) = no cap: every passing threat gets a scenario. Set N to
# keep only the best N (the rest are banked, re-servable by "generate next set").
# TSG_SCOPING_TOP_N=
# Bonus points from the automatic OT rules (only ever adds, never blocks).
# Max threats the AI may propose PER IDENTIFICATION CALL (frozen into the session
# snapshot at create) — "generate next set" shortfalls may run more calls, so a
# session's total threats can grow beyond this.
# (TSG_VALIDATOR_BATCH_SIZE is retired with the LLM validator — library candidates are
# gated by the local reranker now; a stale line here is silently ignored.)

# Library-first relevance gate. Measure the threshold on this environment before pinning:
#   python scripts/measure_threat_relevance_scores.py
# TSG_THREAT_RETRIEVAL_TOP_K=100
# TSG_THREAT_RELEVANCE_THRESHOLD=50.0
# TSG_THREAT_LLM_MAX_GENERATION=15

# TSG_MAX_THREATS_PER_ASSET=10
# Maximum actor names accepted from one threat.
# TSG_MAX_ACTORS_PER_THREAT=10
# Actor names shown as preferred spellings in the prompt (hint, not a gate); cached
# this many seconds (0 = no caching).


# --- 10. Scenario generation & dedup -----------------------------------------
# How many scenarios are written per click, and how duplicates are caught.
# SPEND NOTE: a threat's total scenario count is DERIVED, not configured — its
# target is the entry points the AI declared PLAUSIBLE on its first scenario
# (a subset of the supporting systems + the asset itself), so cost scales with
# the asset's architecture, not a fixed cap.

# Scenarios delivered per "generate next set" click.
# TSG_NEXT_SET_SIZE=5
# Extra tries beyond a threat's coverage target. Example: 3 plausible entry
# points -> at most 3 + 2 = 5 scenario rows for that threat.
# TSG_COVERAGE_ATTEMPT_SLACK=2
# Maximum characters used for prior threat labels in a prompt.
# TSG_EXCLUSIONS_CHAR_BUDGET=24000
# Existing scenarios shown back to the AI so the next one is different.
# TSG_VARIANT_SIBLING_PROMPT_K=3
# Similarity (0-1) at which two threats count as the same idea reworded.
# Example: "Firmware tampering" vs "Tampering of firmware" scores ~0.99 -> the
# second is dropped as a duplicate.
# TSG_SEMANTIC_NEAR_DUPLICATE_THRESHOLD=0.92
# Stricter bar for the same text filed under a DIFFERENT category.
# TSG_SEMANTIC_CROSS_CATEGORY_THRESHOLD=0.98
# Advisory-only completeness check on GET /sessions/{id}; never gates anything. Off = nothing
# computed, logged, or stored -- not just hidden from the API.
# TSG_COVERAGE_REPORTING_ENABLED=false
# Text similarity that flags a scenario for the reviewer (warning only).
# TSG_SIBLING_SIMILARITY_RATIO=0.85
# Max characters of one AI threat proposal.
# TSG_MAX_PROPOSAL_CHARS=3500
# Scenarios named individually in the accept confirmation message.
# TSG_ACCEPT_NAMED_IN_MESSAGE=3


# --- 12. Reaper & pipeline resilience ----------------------------------------
# Crashed/abandoned-session sweep interval and grace window.
# TSG_REAPER_INTERVAL_SECONDS=60.0
# TSG_REAPER_STALE_GRACE_SECONDS=300.0
# CAS lock/lease duration per pipeline stage, and its retry cap.
# TSG_STAGE_LEASE_SECONDS=300
# TSG_STAGE_MAX_ATTEMPTS=5
# TSG_BROKER_VISIBILITY_TIMEOUT_SECONDS=3600
# How long a killed worker's message sits unredelivered, AND the hard ceiling for every task
# time limit — past it the broker redelivers while the first attempt may still be running.
# LEAVE UNSET: derived per environment (lease x 2, capped at 90% of the ceiling above). A
# constant cannot be right in more than one — dev/prod derive a 720s lease, UAT 2880s — so a
# pin either kills healthy UAT work or is useless in dev. Boot refuses a pin below one lease.
# TSG_SUBSYSTEM_TASK_SOFT_LIMIT_SECONDS=
# TSG_REAPER_SQL_IN_CHUNK_SIZE=1000
# TSG_EMBEDDING_GROUP_LOCK_TTL_SECONDS=30


# --- 13. Sessions & capacity -------------------------------------------------
# Backpressure ceilings and warning thresholds.
TSG_MAX_ACTIVE_SESSIONS=100
# 0 (default) = one tenant can consume every MAX_ACTIVE_SESSIONS slot.
TSG_MAX_ACTIVE_SESSIONS_PER_ENTITY=20
# TSG_ACTIVE_SESSIONS_WARN_RATIO=0.9
# TSG_CAPACITY_RETRY_AFTER_SECONDS=10


# --- 14. Treatment plans (risk module) ---------------------------------------
# on: mounts the treatment-plan routes (risk data arrives in the request body).
# TSG_RISK_MODULE_ENABLED=false
# 0 = repeatable plans for identical inputs.
# TSG_TREATMENT_TEMPERATURE=0.0
# LEAVE UNSET to derive from llm timeout x retries.
# TSG_TREATMENT_STALE_SECONDS=
# TSG_TREATMENT_FREE_TEXT_CAP=2000


# --- 15. Threat intel feeds --------------------------------------------------
# Open feeds cached in Mongo, used to enrich generated scenarios.
# TSG_INTEL_ENABLED=true
# TSG_INTEL_KEV_ENABLED=true
# TSG_INTEL_KEV_URL=<set-me>
# TSG_INTEL_ICS_ADVISORIES_ENABLED=true
# TSG_INTEL_ICS_ADVISORIES_URL=<set-me>
# TSG_INTEL_URLHAUS_ENABLED=false
# TSG_INTEL_URLHAUS_URL=<set-me>
# OTX key — its PRESENCE auto-enables the OTX feed.
# OTX_API_KEY=<set-me>
# TSG_INTEL_OTX_URL=<set-me>
# TSG_INTEL_OTX_FRESH_PAGES=2
# TSG_INTEL_OTX_MAX_PAGES=200
# TSG_INTEL_OTX_PAGE_SIZE=50
# TSG_INTEL_OTX_SYNC_SECONDS=400
# TSG_INTEL_TAXII_SERVERS=
# TSG_INTEL_TTL_DAYS=30
# Scheduled refresh of every enabled feed (seconds); 0 = admin-triggered only. 86400 = daily.
# TSG_INTEL_REFRESH_INTERVAL_SECONDS=0
# An enabled feed with no successful refresh inside this window reports stale=true (SDD SOURCE_STALE).
# TSG_INTEL_STALE_AFTER_SECONDS=172800
# Operator country as the feeds spell it; matched against OTX targeted_countries / CISA countries deployed.
# TSG_INTEL_HOME_COUNTRY=United Arab Emirates
# Advisories injected per scenario prompt (raising this raises token spend).
# TSG_PROMPT_INTEL_LIMIT=5
# Shortest word (chars) participating in intel keyword search.
# TSG_INTEL_MIN_TERM_LENGTH=4


# --- 16. Controls mapping & library import -----------------------------------
# LEAVE MIN_SCORE UNSET normally — the cutoff auto-follows this environment's
# model pair; pin only after a manual calibration (controls_mapped audit rows).
# TSG_CONTROL_MAP_MIN_SCORE=60
# TSG_CONTROL_MAP_TOP_K=5

# TSG_CONTROL_MAP_SHORTLIST_K - how many controls reach the RERANKER per scenario (default 60).
# NOT the same as TSG_GROUNDING_SHORTLIST_K, and deliberately so. The shortlist is the cheap
# approximate stage (cosine top-K union BM25 top-K); the reranker is the accurate one. While
# control mapping borrowed the grounding value (10), only 14-20 of 557 OT controls were ever
# reranked - a control the reranker scored 65.86 was discarded before it could be scored at all,
# and the empty result published as a genuine library gap. Grounding's own K stays where it is:
# its thresholds are auto-calibrated against that value.
# COST is provider-shaped: on the reranker API this grows each request's payload, not the number
# of requests (one per scenario, rerank_concurrency-wide). On a LOCAL reranker every (query,
# document) pair is one CPU batch, so it scales linearly - expect slower local sessions.
# TSG_CONTROL_MAP_SHORTLIST_K=60
# Bulk threat-library import limits.
# Embedding-admin job retry cap on LLM slot shortage (0 = fail on first).
# TSG_ADMIN_EMBEDDING_MAX_RETRIES=10


# --- 17. SSE (live progress streams) -----------------------------------------
# Defaults are tuned for a single server with a few dozen concurrent clients.
# TSG_SSE_MAX_CONCURRENT_STREAMS=180
# TSG_SSE_PING_SECONDS=15
# TSG_SSE_PUBLISH_TIMEOUT_SECONDS=1.0
# TSG_SSE_SEND_TIMEOUT_SECONDS=30.0
# TSG_SSE_SHUTDOWN_GRACE_SECONDS=25.0
# TSG_SSE_SUBSCRIBE_CONNECT_TIMEOUT_SECONDS=2.0
# TSG_SSE_SUBSCRIBER_HEALTH_CHECK_INTERVAL_SECONDS=30.0
# TSG_SSE_SUBSCRIBER_SOCKET_TIMEOUT_SECONDS=10.0
# TSG_SSE_BREAKER_COOLDOWN_SECONDS=30.0
# TSG_SELF_CHECK_INTERVAL_SECONDS=300.0


# --- 18. HTTP & CORS ---------------------------------------------------------
# Empty (default) = no cross-origin browser access. JSON list of origins.
# TSG_CORS_ALLOWED_ORIGINS=[]


# --- 19. Ops warnings --------------------------------------------------------
# TSG_TEMPDB_LONG_TXN_WARN_SECONDS=300
# TSG_TEMPDB_VERSION_STORE_WARN_MB=1024
# TSG_POOL_UTILIZATION_WARN_RATIO=0.9


# --- Settings documented for env_selfcheck (see app/core/env_selfcheck.py) ---
# All commented: each is left at its code default unless deliberately overridden.
# How often the control-map retry queue is drained (beat task tsg.map_controls_sweep).
# map_controls leaves an output unstamped for the next run on three paths (no candidates,
# lost lease, failed rerank); this IS that next run. Ticking faster than stage_lease_seconds
# buys nothing — the sweep skips anything settled within one lease.
# TSG_CONTROL_MAP_SWEEP_INTERVAL_SECONDS=300.0
# TSG_CONTROL_MAP_MAX_ATTEMPTS=5
# Scenarios generated at once in one write_scenarios batch (1 = strictly sequential).
# A LOCAL POLITENESS CAP ONLY: every call still takes its own Redis LLM slot, so
# MAX_CONCURRENT_LLM_CALLS stays the global authority. Raise only alongside the provider's
# rpm headroom — exhausting the slot pool raises LLMSlotUnavailable and retries the stage.
# TSG_SCENARIO_GENERATION_CONCURRENCY=5

# TSG_GAP_GENERATION_BUFFER — gap generation loses proposals to dedup, so the ask is
# multiplied by this and the surplus discarded. 2.0 absorbs a 50% repeat rate; raise it if
# "show more 5" still returns 4 against this deployment's library. 1.0 disables the buffer.
# TSG_GAP_GENERATION_BUFFER=2.0

{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",

  "python.testing.pytestEnabled": true,
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python-envs.defaultEnvManager": "ms-python.python:system",

  // The Mypy Type Checker extension does NOT inherit python.defaultInterpreterPath above:
  // without an explicit cwd/interpreter it can invoke mypy from the wrong place and report
  // dozens of false "Missing named argument" errors on Settings, as if the pydantic.mypy
  // plugin config in pyproject.toml were never found. The explicit --config-file makes
  // discovery unambiguous either way.
  "mypy-type-checker.interpreter": ["${workspaceFolder}/.venv/Scripts/python.exe"],
  "mypy-type-checker.cwd": "${workspaceFolder}",
  "mypy-type-checker.args": ["--config-file=${workspaceFolder}/pyproject.toml"]
}

# Copy to .env for local dev. All keys are prefixed TSG_ (see app/core/config.py).
# TSG_DB_DSN=mssql+pyodbc://sa:Dev_Str0ng_Pass!@localhost:1433/TSG?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
TSG_DB_DSN="mssql+pyodbc://@XWF8TNJR3\SQLEXPRESS/TSG?driver=ODBC+Driver+17+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=yes"

TSG_REDIS_URL=redis://localhost:6379/0
TSG_MONGO_URL=mongodb://localhost:27017
TSG_LITELLM_BASE_URL=http://localhost:4000
TSG_LITELLM_API_KEY=sk-local

# LLM inference provider — swap without code changes (inference/generation only).
# LLM_PROVIDER = litellm_proxy (default) | azure_openai | openai
LLM_PROVIDER=azure_openai
# Azure OpenAI (chat model). Put the REAL key in .env ONLY (git-ignored) — never here.
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://ccpm-control-extraction-resource.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Embedding provider (local in-process model, no network | litellm_proxy).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=C:/Users/User/Documents/ResearchWorld/NETRA/DESC_RAG_BOT/models/multilingual-e5-large
EMBEDDING_DIMENSIONS=1024
SEMANTIC_MATCH_THRESHOLD=0.60

# Reranker provider (local in-process model, no network | litellm_proxy).
RERANKER_PROVIDER=local
RERANKER_MODEL=C:/Users/User/Documents/GC_Research/Threat_Sceario_Generator/cii-threat-scenario-generator/models/bge-reranker-v2-m3


# JWT resource-server validation (SDD §10.1) — point at the platform/SSO issuer.
TSG_JWT_ISSUER=https://sso.example/realms/platform
TSG_JWT_AUDIENCE=tsg
TSG_JWT_JWKS_URL=https://sso.example/realms/platform/protocol/openid-connect/certs

# Copy this to .env for local development. Settings are prefixed TSG_ unless noted (see app/core/config.py).
# TSG_DB_DSN=mssql+pyodbc://sa:Dev_Str0ng_Pass!@localhost:1433/TSG?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
# TSG_DB_DSN="mssql+pyodbc://@XWF8TNJR3\SQLEXPRESS/TSG?driver=ODBC+Driver+17+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=yes"

TSG_DB_DSN="mssql+pyodbc://@XWF8TNJR3\SQLEXPRESS/TSG?driver=ODBC+Driver+17+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=yes"

# TSG_DB_DSN="mssql+pyodbc://Desc_Produser:20M%24Y%2AJu%26Bg%402na1@10.228.146.2:1444/EYShieldDB_Copy?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no"

TSG_REDIS_URL=redis://localhost:6379/0
TSG_MONGO_URL=mongodb://localhost:27017
TSG_LITELLM_BASE_URL=http://localhost:4000
TSG_LITELLM_API_KEY=sk-local

# Which AI service handles chat. Default here is azure_openai (real Azure access, no proxy
# needed in dev). Other options: openai, litellm_proxy (used for UAT/production — see below).
LLM_PROVIDER=azure_openai

# Put your REAL Azure key in .env only — never commit it.
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://ccpm-control-extraction-resource.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# UAT/production alternative — route chat through litellm instead of Azure directly:
#   LLM_PROVIDER=litellm_proxy
#   TSG_LITELLM_BASE_URL=https://llmapi.govai.ae
#   TSG_LITELLM_API_KEY=<real key — never commit it>
#   TSG_INFERENCE_MODEL=glm-5   # or kimi-k2.5 — just swap this one value, no code change
#
# UAT/production timeout: the default 90s is tuned for direct Azure. The proxy's self-hosted
# models allow up to 1800s and QUEUE under concurrent load — a live probe (2026-07-30) measured
# 36s for one uncontended kimi-k2.5 call, so several simultaneous users push waits past 90s and
# a too-early timeout burns all retries and fails the stage while the model is still working.
#   TSG_LLM_TIMEOUT_SECONDS=600
# Leave TSG_STAGE_LEASE_SECONDS UNSET alongside it: the lease auto-derives as
# timeout x (retries+1) x 2 (config._derive_stage_lease_seconds), so the reaper's "worker is
# dead" window grows with the timeout automatically. If you DO pin the lease explicitly, the
# app refuses to start below the safe floor (timeout x (retries+1)) rather than risk reaping a
# slow-but-alive call. Model note: kimi-k2.5 carries a platform-wide rpm=192 shared across ALL
# teams (glm-5 has no rpm limit) — a persistent 429 from that limit now retries via the same
# backoff path as slot contention instead of failing the session (llm._provider_429_retryable).

# Embedding provider is left UNSET on purpose: it follows LLM_PROVIDER automatically (see
# app/core/config.py). With azure_openai above, that means "local"; switch LLM_PROVIDER to
# litellm_proxy and this follows automatically too. Only set EMBEDDING_PROVIDER below if you
# want it to differ from LLM_PROVIDER (e.g. chat via the proxy but embeddings kept local).
# EMBEDDING_PROVIDER=local
# EMBEDDING_DIMENSIONS must match whichever model is actually active, or the app refuses to
# start — 1024 is correct for the local model below; litellm_proxy needs its own value
# (e.g. 4096 for qwen3-embedding-8b-mig).
EMBEDDING_MODEL=C:/Users/User/Documents/ResearchWorld/NETRA/DESC_RAG_BOT/models/multilingual-e5-large
EMBEDDING_DIMENSIONS=1024
SEMANTIC_MATCH_THRESHOLD=0.60

# For litellm_proxy, use proxy values instead of the local path/width above:
#   TSG_EMBEDDING_MODEL=qwen3-embedding-8b-mig
#   EMBEDDING_DIMENSIONS=4096

# Reranker provider — same "follows LLM_PROVIDER unless set" rule as embedding above.
# RERANKER_PROVIDER=local
RERANKER_MODEL=C:/Users/User/Documents/GC_Research/Threat_Sceario_Generator/cii-threat-scenario-generator/models/bge-reranker-v2-m3
# For litellm_proxy, use a proxy model name instead:
#   TSG_RERANKER_MODEL=qwen3-reranker-8b-mig

# Step-4 control mapping knobs (defaults are fine for dev; revisit per environment):
# - TSG_CONTROL_MAP_MIN_SCORE: LEAVE UNSET normally — the cutoff then follows the
#   per-model-pair confirm threshold automatically (grounding.resolve_thresholds), so a
#   UAT/prod model swap re-derives it. Set it only to PIN a static cutoff after a manual
#   calibration (the controls_mapped audit rows carry the applied cutoff + scores).
# - TSG_RERANK_CONCURRENCY only matters with a REMOTE reranker: how many rerank HTTP calls
#   run at once (local politeness cap; the Redis LLM-slot semaphore stays the global limit).
#   The local reranker batches everything into one model call and ignores this.
# TSG_CONTROL_MAP_MIN_SCORE=60
# TSG_CONTROL_MAP_TOP_K=5
# TSG_RERANK_CONCURRENCY=8

# "Generate next set" accumulation knobs (defaults fine for dev):
# - TSG_NEXT_SET_SIZE: scenarios served/generated per "generate next set" click (default 5).
# - TSG_MAX_SCENARIOS_PER_THREAT: coexisting scenarios one threat may hold — the original plus
#   N-1 alternates written when no brand-new threat can be found (default 2). Config-only to
#   change; also bounds the variant prompt (at most N-1 sibling scenarios are ever included)
#   and the per-session generation ceiling (threats × N scenario calls, total).
# TSG_NEXT_SET_SIZE=5
# TSG_MAX_SCENARIOS_PER_THREAT=2

# Optional safety features (litellm_proxy only, both off by default — safe to leave commented out in dev).
# LLM_MODERATION_ENABLED=true                # flags generated scenario text; a soft flag, never a hard block
# LLM_MODERATION_MODEL=<proxy's moderation model name>   # optional — omit to use the proxy's default
# LLM_GUARDRAILS=["pii-detector"]             # optional proxy-side safety filter name(s)


# Live threat intelligence (open feeds cached in Mongo, used to enrich generated scenarios).
# Ships OFF. See documents/Threat_Intel_Operations_Guide.md for the full reference.
# TSG_INTEL_ENABLED=true                     # master switch: daily beat refresh + scenario enrichment
# TSG_INTEL_TTL_DAYS=30                       # cache TTL (only purges items a feed has dropped)
# TSG_INTEL_REFRESH_INTERVAL_SECONDS=86400   # beat cadence (default daily)
# KEV + CISA ICS advisories are on by default when the master switch is set. Opt-in extras:
# TSG_INTEL_URLHAUS_ENABLED=true             # malicious-URL IOC feed (cached, NOT used in prompts)
# OTX_API_KEY=your-free-alienvault-otx-key   # enables OTX pulses (feed stays off while empty)
# TSG_INTEL_TAXII_SERVERS=[{"label":"org-opencti","url":"https://cti.example/taxii2/root/","collection":"<id>"}]

# Login-system (SSO) settings — point at your platform's real issuer.
TSG_JWT_ISSUER=https://sso.example/realms/platform
TSG_JWT_AUDIENCE=tsg
TSG_JWT_JWKS_URL=https://sso.example/realms/platform/protocol/openid-connect/certs

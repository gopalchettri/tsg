# --- 19. Ops warnings --------------------------------------------------------
# TSG_TEMPDB_LONG_TXN_WARN_SECONDS=300
# TSG_TEMPDB_VERSION_STORE_WARN_MB=1024
# TSG_POOL_UTILIZATION_WARN_RATIO=0.9


# --- Settings documented for env_selfcheck (see app/core/env_selfcheck.py) ---
# All commented: each is left at its code default unless deliberately overridden.
# How often the control-map retry queue is drained (beat task tsg.map_controls_sweep).
# map_controls leaves an output unstamped for the next run on three paths (no candidates,
# lost lease, failed rerank); this IS that next run. Ticking faster than stage_lease_seconds
# buys nothing — the sweep skips anything settled within one lease.
# TSG_CONTROL_MAP_SWEEP_INTERVAL_SECONDS=300.0
# Scenarios generated at once in one write_scenarios batch (1 = strictly sequential).
# A LOCAL POLITENESS CAP ONLY: every call still takes its own Redis LLM slot, so
# MAX_CONCURRENT_LLM_CALLS stays the global authority. Raise only alongside the provider's
# rpm headroom — exhausting the slot pool raises LLMSlotUnavailable and retries the stage.
# TSG_SCENARIO_GENERATION_CONCURRENCY=5

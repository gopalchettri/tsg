# --- 16. Controls mapping & library import -----------------------------------
# LEAVE MIN_SCORE UNSET normally — the cutoff auto-follows the model pair; pin
# only after a manual calibration (controls_mapped audit rows carry the data).
# TSG_CONTROL_MAP_MIN_SCORE=60
# TSG_CONTROL_MAP_TOP_K=5

# TSG_CONTROL_MAP_SHORTLIST_K - how many controls reach the RERANKER per scenario (default 60).
# NOT the same as TSG_GROUNDING_SHORTLIST_K, and deliberately so. The shortlist is the cheap
# approximate stage (cosine top-K union BM25 top-K); the reranker is the accurate one. While
# control mapping borrowed the grounding value (10), only 14-20 of 557 OT controls were ever
# reranked - a control the reranker scored 65.86 was discarded before it could be scored at all,
# and the empty result published as a genuine library gap. Grounding's own K stays where it is:
# its thresholds are auto-calibrated against that value.
# COST is provider-shaped: on the reranker API this grows each request's payload, not the number
# of requests (one per scenario, rerank_concurrency-wide). On a LOCAL reranker every (query,
# document) pair is one CPU batch, so it scales linearly - expect slower local sessions.
# TSG_CONTROL_MAP_SHORTLIST_K=60
# Bulk threat-library import limits.
# TSG_LIBRARY_IMPORT_STALE_AFTER_SECONDS=3600
# TSG_LIBRARY_IMPORT_SKIPPED_CAP=50
# TSG_THREAT_LIBRARY_IMPORT_MAX_UPLOAD_MB=128
# Embedding-admin job retry cap on LLM slot shortage (0 = fail on first).
# TSG_ADMIN_EMBEDDING_MAX_RETRIES=10



# =============================================================================
# TSG dev template — copy to .env for local development and fill in real values.
# Settings are prefixed TSG_ unless noted; app/core/config.py is the source of
# truth for meaning, defaults, and bounds. Convention: ACTIVE lines override the
# code default; COMMENTED lines show the default — uncomment only to override.
# The key set is kept in sync across .env / .env.example / .env.uat /
# .env.prod.example; only the VALUES differ per environment.
# Names not defined in config.py are silently ignored (extra='ignore') — keep
# this file in sync: python -m app.core.env_selfcheck
# =============================================================================


# --- 1. Core app -------------------------------------------------------------
# App identity shown in OpenAPI docs (/docs title, version, description).
# TSG_APPLICATION_NAME=Threat Scenario Generator
# TSG_APPLICATION_VERSION=1.0
# TSG_APPLICATION_DESCRIPTION=AI-assisted STRIDE threat identification and scenario generation for OT/IT assets
# Deployment environment: local/dev/staging/prod.
# APP_ENV=prod
# This deployment's module identity; an API_Client key is valid ONLY for its Module.
# TSG_API_MODULE=tsg
# TSG_TENANT_ID=DESC
# LOG_LEVEL=INFO
# --- Step tracing (app.core.tracing) -----------------------------------------
# Where the per-step trace goes. Comma list of:
#   console  human-readable blocks on stdout (the worker window)
#   log      through structlog, so steps join the normal JSON log stream -> Loki
#   file     trace-<pid>.jsonl (summarised, Loki-safe) + trace-<pid>.txt (full dump)
# Empty = tracing off entirely. RESTART-ONLY: settings are cached at startup, so
# changing this while the app runs does nothing until you restart it.
# TRACE_SINKS=
# Where the file sinks write. Relative paths resolve against the PROJECT ROOT, not the
# working directory (start.ps1 opens three windows from different places).
# TRACE_DIR=logs/trace
# Rotation, applied PER PROCESS — each writer gets its own file, because the API workers,
# the Celery worker and beat all log at once and a shared file rotates wrongly on Linux and
# not at all on Windows. Disk budget = processes x TRACE_MAX_BYTES x TRACE_BACKUPS.
# TRACE_MAX_BYTES=52428800
# TRACE_BACKUPS=5
# Tee EVERY app log line (not just traces) into app-<pid>.jsonl for Promtail -> Loki.
# Leave OFF inside Docker/Kubernetes: files die with the container and the platform already
# rotates stdout for you.
# LOG_FILE=false



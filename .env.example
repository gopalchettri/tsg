TSG_DB_DSN="mssql+pyodbc://@XWF8TNJR3\SQLEXPRESS/TSG?driver=ODBC+Driver+17+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=yes"
# Alternatives: local SQL auth, or the shared remote copy.
# TSG_DB_DSN=mssql+pyodbc://sa:Dev_Str0ng_Pass!@localhost:1433/TSG?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
# TSG_DB_DSN="mssql+pyodbc://Desc_Produser:20M%24Y%2AJu%26Bg%402na1@10.228.146.2:1444/EYShieldDB_Copy?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no"
# Connection-pool and timeout knobs.
# TSG_DB_POOL_SIZE=50
# TSG_DB_MAX_OVERFLOW=10
# TSG_DB_POOL_TIMEOUT=30
# TSG_DB_CONNECT_TIMEOUT_SECONDS=5
# TSG_DB_STATEMENT_TIMEOUT_SECONDS=30


# --- 3. Redis & Celery -------------------------------------------------------
# Main Redis connection: SSE pub/sub, LLM concurrency slots, embedding-group locks.
TSG_REDIS_URL=redis://localhost:6379/0
# Celery queue/result URLs (fall back to TSG_REDIS_URL when unset).
# CELERY_BROKER_URL=<set-me>
# CELERY_RESULT_BACKEND=
# TSG_RESULT_EXPIRES_SECONDS=3600


# --- 4. MongoDB (embedding cache) --------------------------------------------
# Caches AI-generated embedding vectors so the same text is never re-embedded.
TSG_MONGO_URL=mongodb://localhost:27017
# TSG_MONGO_DB=tsg_embeddings
# TSG_MONGO_CONNECT_TIMEOUT_MS=3000
# TSG_MONGO_BREAKER_COOLDOWN_SECONDS=30.0
# EMBEDDING_STORE=mongo


# --- 5. Auth & security ------------------------------------------------------
# Admin gate for all admin routes (X-Admin-Key header); empty = every admin route 401s.
# ADMIN_API_KEY=<set-me>
# true = also verify (user, entity) against user_scope_assignment on every request.
# TSG_VERIFY_MEMBERSHIP=false
# APP_ENV=local/dev refuses to boot against a non-loopback database or Redis, because that
# combination silently disables four production guards (raw exception text to clients, the
# /dev/sse-test page, the active-API_Client boot check, and the membership warning). Set this
# true to state deliberately that you are developing against shared infrastructure.
# TSG_ALLOW_REMOTE_IN_DEV=false
# NOTE: TSG_JWT_*/AUTH_DEV_MODE no longer exist — if set they are silently
# ignored; header auth (X-API-Key) is the only auth model.
# "user:password" for the Flower dashboard. INFRA-ONLY: read directly by
# start.ps1 and docker/compose.prod.yml (which requires it), not by app config.
# FLOWER_BASIC_AUTH=<set-me>


# --- 6. LLM — chat provider --------------------------------------------------
# Which AI service handles chat: azure_openai (dev default), openai, or
# litellm_proxy (UAT/production — see the recipe below).
LLM_PROVIDER=azure_openai
# Azure OpenAI credentials — put your REAL key in .env only, never commit it.
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://ccpm-control-extraction-resource.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# litellm proxy connection — read only when LLM_PROVIDER=litellm_proxy.
TSG_LITELLM_BASE_URL=http://localhost:4000
TSG_LITELLM_API_KEY=sk-local
# UAT/production recipe — route chat through litellm instead of Azure:
#   LLM_PROVIDER=litellm_proxy
#   TSG_LITELLM_BASE_URL=https://llmapi.govai.ae
#   TSG_LITELLM_API_KEY=<real key — never commit it>
#   TSG_INFERENCE_MODEL=glm-5   # or kimi-k2.5 — swap this one value, no code change
#   TSG_LITELLM_BYPASS_PROXY=false  # only if the network REQUIRES HTTP_PROXY routing
#   TSG_LLM_TIMEOUT_SECONDS=600     # proxy models queue under load; 90s burns retries early
# Leave TSG_STAGE_LEASE_SECONDS unset with a long timeout — the lease auto-derives
# from timeout x (retries+1) x 2, so the reaper's "worker dead" window grows with it.
# (kimi-k2.5 has a shared platform rpm=192; a persistent 429 retries via backoff.)
# LITELLM_API_KEY_HEADER=
# LLM_JSON_MODE=false
# TSG_LLM_MAX_RETRIES=3
# LLM_TEMPERATURE=
# LLM_REASONING_EFFORT=
# Optional proxy-side safety (litellm_proxy only; defaults: off/empty). Recipe:
#   LLM_MODERATION_ENABLED=true
#   LLM_MODERATION_MODEL=<proxy's moderation model name>
#   LLM_GUARDRAILS=["pii-detector"]
# OpenAI-direct fallbacks.
# OPENAI_API_KEY=<set-me>
# TSG_OPENAI_BASE_URL=<set-me>
# Per-stage sampling temperatures.
# THREAT_IDENTIFICATION_TEMPERATURE=0.0
# SCENARIO_GENERATION_TEMPERATURE=
# Concurrency slots limiting simultaneous LLM calls (0 = unlimited).
# TSG_MAX_CONCURRENT_LLM_CALLS=0
# TSG_LLM_SLOT_WAIT_TIMEOUT_SECONDS=30.0
# TSG_LLM_SLOT_HEARTBEAT_SECONDS=10.0
# TSG_LLM_SLOT_STALE_AFTER_SECONDS=30.0
# TSG_LLM_SLOT_REDIS_TIMEOUT_SECONDS=3.0
# TSG_LLM_SLOT_POLL_SECONDS=0.25
# TSG_LLM_SLOT_POLL_JITTER_SECONDS=0.1
# TSG_LLM_SLOTS_WARN_RATIO=0.8
# Retries for the LLM output-verification pass.
# TSG_LLM_VERIFY_MAX_ATTEMPTS=3
# TSG_LLM_VERIFY_RETRY_BACKOFF_SECONDS=5.0


# --- 7. Embeddings & reranker ------------------------------------------------
# Providers are left UNSET on purpose: they follow LLM_PROVIDER automatically
# (azure_openai above -> "local"). Set them only for a hybrid setup (e.g. chat via
# proxy, embeddings local).
# EMBEDDING_PROVIDER=local
# RERANKER_PROVIDER=local
# Local file path of the embedding model.
EMBEDDING_MODEL=C:/Users/User/Documents/ResearchWorld/NETRA/DESC_RAG_BOT/models/multilingual-e5-large
# Vector size — MUST match the active model or the app refuses to start
# (1024 for the local e5 model; e.g. 4096 for qwen3-embedding-8b-mig on the proxy).
EMBEDDING_DIMENSIONS=1024
# Local file path of the reranker (cross-encoder).
RERANKER_MODEL=C:/Users/User/Documents/GC_Research/Threat_Sceario_Generator/cii-threat-scenario-generator/models/bge-reranker-v2-m3
# litellm_proxy recipe — proxy model names instead of local paths:
#   TSG_EMBEDDING_MODEL=qwen3-embedding-8b-mig
#   EMBEDDING_DIMENSIONS=4096
#   TSG_RERANKER_MODEL=qwen3-reranker-8b-mig
# EMBEDDING_PREFIX_STYLE=auto
# TSG_EMBEDDING_BATCH_SIZE=32   # provider per-request cap; 32 for qwen3-embedding-8b-mig
# TSG_EMBEDDING_CONCURRENCY — how many embedding batches are in flight at once.
# 1 (default) sends them one at a time, exactly as before. Higher overlaps the network
# waits: modelled at 300ms/request, 4 -> 3.4x and 8 -> 5.6x on a full recreate. Each
# concurrent call still takes its own LLM slot, so MAX_CONCURRENT_LLM_CALLS stays the
# authority. Raise it 1 -> 4 -> 8 while watching the worker log for 429s: a 429 retries the
# WHOLE job, so too much concurrency is slower than none. Gains nothing if the provider
# serialises requests internally — measure before trusting the numbers above.
# TSG_EMBEDDING_CONCURRENCY=1
# TSG_MAX_EMBED_CHARS=4000
# TSG_MAX_CHAT_CHARS=60000
# TSG_LOCAL_MODEL_CACHE_SIZE=4
# TSG_LOCAL_MODEL_THREADPOOL_SIZE=10
# Concurrent REMOTE rerank HTTP calls (a local reranker batches and ignores this).
# TSG_RERANK_CONCURRENCY=8


# --- 8. Matching & grounding -------------------------------------------------
# Runs during threat identification, right after the AI proposes each threat.
# Question it answers: "is this already in our threat library, or new?"
# Flow: STEP A shortlist similar entries -> STEP B keep the top K
# -> STEP C precise score decides trust.

# STEP A — shortlist. The proposed threat and every library entry are compared
# as vectors (similarity 0-1); entries below this are ignored, the rest become
# candidates. Example — AI proposes "Firmware tampering of meters":
#   library "Firmware tampering"    0.86 -> candidate
#   library "Phishing of operators" 0.31 -> ignored
# If NOTHING clears the floor, the top K still go to step C anyway (fail-open),
# so a weak-but-best match is judged rather than silently dropped.
SEMANTIC_MATCH_THRESHOLD=0.60
# STEP B — cap. Only the K most similar candidates from step A go on to the
# precise (slower) scorer in step C.
# TSG_GROUNDING_SHORTLIST_K=10
# STEP C — trust decision. The reranker model scores each remaining candidate
# 0-100; the BEST score decides what happens to the proposed threat:
#   >= threshold -> "verified": it ADOPTS the library entry's official name
#                   and ids (dedup, reports, and prompts use the library row).
#   <  threshold -> "unverified": kept as possibly NEW — it still gets
#                   scenarios, and on accept feeds the admin queue (group 11).
# LEAVE UNSET here so auto-calibration picks it per model pair (the dev .env
# pins 90 instead — its catalogue's near-twin entries defeat calibration).
# TSG_ prefix REQUIRED (a bare GROUNDING_MATCH_THRESHOLD is silently ignored).
# TSG_GROUNDING_MATCH_THRESHOLD=
# The two below are used ONLY by the calibration script that tries to compute
# the step-C threshold from the library itself (scripts/calibrate_grounding.py).
# Stop calibrating when two LIBRARY entries score >= this against each other —
# the library holds near-twins, so no reliable threshold can be computed.
# TSG_NEAR_DUPLICATE_SCORE=99.0
# How many library names it samples / paraphrases it generates per name.
# TSG_CALIBRATION_SAMPLE_SIZE=100
# TSG_CALIBRATION_PARAPHRASES_PER_NAME=2


# --- 9. Scoring & scoping ----------------------------------------------------
# Every identified threat gets a score; only high scorers get scenarios.

# Starting score for every threat. Example: start 50, one matching rule adds
# +10 -> 60, which passes the 55 cutoff. (50 + 10 must stay above the cutoff
# or the app refuses to start.)
# TSG_BASE_SCORE=50.0
# Points a scoping rule adds when it defines no weight of its own.
# TSG_DEFAULT_RULE_WEIGHT=10.0
# Minimum score a threat needs to survive. Example: 60 passes, 52 is dropped.
# TSG_SCOPING_SCORE_THRESHOLD=55.0
# Unset (the default) = no cap: every passing threat gets a scenario. Set N to
# keep only the best N (the rest are banked, re-servable by "generate next set").
# TSG_SCOPING_TOP_N=
# Bonus points from the automatic OT rules (only ever adds, never blocks).
# TSG_AUTO_OT_RELEVANCE_WEIGHT=10.0
# Max threats the AI may propose PER IDENTIFICATION CALL (frozen into the session
# snapshot at create) — "generate next set" shortfalls may run more calls, so a
# session's total threats can grow beyond this.
# TSG_THREAT_RETRIEVAL_TOP_K - cap on library candidates the retrieval funnel forwards to the
# LLM validator. LEAVE UNSET at today's library size (~75 rows): every gate-passing candidate
# is validated, which is what makes the coverage claim exhaustive rather than sampled. Set it
# only once the library outgrows validate-everything; gate-ungated ("always-eligible") types
# bypass the cap so universal threats survive it.
# TSG_THREAT_RETRIEVAL_TOP_K=
# TSG_VALIDATOR_BATCH_SIZE - library candidates judged per LLM validation call. One batched
# call for the whole set is the norm at today's size; batches only split above this.
TSG_VALIDATOR_BATCH_SIZE=20

# TSG_MAX_THREATS_PER_ASSET=10
# Maximum actor names accepted from one threat.
# TSG_MAX_ACTORS_PER_THREAT=10
# Actor names shown as preferred spellings in the prompt (hint, not a gate); cached
# this many seconds (0 = no caching).
# TSG_ACTOR_VOCABULARY_CAP=300
# TSG_ACTOR_VOCABULARY_CACHE_SECONDS=30.0


# --- 10. Scenario generation & dedup -----------------------------------------
# How many scenarios are written per click, and how duplicates are caught.
# A threat's total scenario count is DERIVED, not configured: its target is the
# entry points the AI declared PLAUSIBLE on its first scenario (a subset of the
# supporting systems + the asset itself).

# Scenarios delivered per "generate next set" click.
# TSG_NEXT_SET_SIZE=5
# Extra tries beyond a threat's coverage target. Example: 3 plausible entry
# points -> at most 3 + 2 = 5 scenario rows for that threat.
# TSG_COVERAGE_ATTEMPT_SLACK=2
# Maximum characters used for prior threat labels in a prompt.
# TSG_EXCLUSIONS_CHAR_BUDGET=24000
# Existing scenarios shown back to the AI so the next one is different.
# TSG_VARIANT_SIBLING_PROMPT_K=3
# Similarity (0-1) at which two threats count as the same idea reworded.
# Example: "Firmware tampering" vs "Tampering of firmware" scores ~0.99 -> the
# second is dropped as a duplicate.
# TSG_SEMANTIC_NEAR_DUPLICATE_THRESHOLD=0.92
# Stricter bar for the same text filed under a DIFFERENT category.
# TSG_SEMANTIC_CROSS_CATEGORY_THRESHOLD=0.98
# Text similarity that flags a scenario for the reviewer (warning only).
# TSG_SIBLING_SIMILARITY_RATIO=0.85
# Max characters of one AI threat proposal.
# TSG_MAX_PROPOSAL_CHARS=3500
# Scenarios named individually in the accept confirmation message.
# TSG_ACCEPT_NAMED_IN_MESSAGE=3


# --- 11. Library promotion & admin review queue ------------------------------
# Curation cutoff: a threat scoring BELOW this feeds library growth on accept.
# Independent of the match threshold above and must never exceed it (boot fails).
# TSG_LIBRARY_PROMOTION_THRESHOLD=75.0
# Triage bands (cosine of candidate generic name vs nearest catalogue entry).
# approve must stay BELOW reject — the gap IS the human-review band. Recalibrate
# from promotion_triage audit rows after any embedding-model change.
# TSG_TRIAGE_AUTO_REJECT_COSINE=0.95
# TSG_TRIAGE_AUTO_APPROVE_COSINE=0.80
# MASTER SWITCH for AI-driven library growth. false (default): every novel threat
# type, name, and actor waits as an admin review card — nothing enters the shared
# library without approval. true: full auto-promotion at accept (ai_auto_promoted).
# TSG_PROMOTION_AUTO_APPROVE_ENABLED=false
# Failed-promotion retry sweep (admin API /v1/tsg/sessions/promotions/*).
# TSG_PROMOTION_RETRY_INTERVAL_SECONDS=60.0
# Auto-retries before a failure is "exhausted" (admin retry still works past it).
# TSG_PROMOTION_MAX_ATTEMPTS=5
# false = failures wait for an admin instead of being retried automatically.
# TSG_PROMOTION_AUTO_RETRY_ENABLED=true
# Max sessions retried per sweep pass.
# TSG_PROMOTION_SWEEP_BATCH_LIMIT=200
# Page-size cap for the admin promotions list.
# TSG_PROMOTION_LIST_MAX_LIMIT=500


# --- 12. Reaper & pipeline resilience ----------------------------------------
# Crashed/abandoned-session sweep interval and grace window.
# TSG_REAPER_INTERVAL_SECONDS=60.0
# TSG_REAPER_STALE_GRACE_SECONDS=300.0
# CAS lock/lease duration per pipeline stage, and its retry cap.
# TSG_STAGE_LEASE_SECONDS=300
# TSG_STAGE_MAX_ATTEMPTS=5
# TSG_REAPER_SQL_IN_CHUNK_SIZE=1000
# TSG_EMBEDDING_GROUP_LOCK_TTL_SECONDS=30


# --- 13. Sessions & capacity -------------------------------------------------
# Backpressure ceilings (0 = unlimited, the default) and warning thresholds.
# TSG_MAX_ACTIVE_SESSIONS=0
# TSG_MAX_ACTIVE_SESSIONS_PER_ENTITY=0
# TSG_ACTIVE_SESSIONS_WARN_RATIO=0.9
# TSG_CAPACITY_RETRY_AFTER_SECONDS=10


# --- 14. Treatment plans (risk module) ---------------------------------------
# on: mounts the treatment-plan routes (risk data arrives in the request body).
# RISK_MODULE_ENABLED=false
# 0 = repeatable plans for identical inputs.
# TREATMENT_TEMPERATURE=0.0
# RUNNING plan with no progress for this long: re-claimable / shown timed out.
# TREATMENT_STALE_SECONDS=900
# TSG_TREATMENT_FREE_TEXT_CAP=2000


